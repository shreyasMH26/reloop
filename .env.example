# ============================================
# ReLoop Environment Configuration (.env.example)
# ============================================

# Backend Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=reloop-secure-jwt-secret-key-vtu-2025

# Database Configuration (PostgreSQL)
# When left blank, ReLoop runs in development mode using its embedded file-backed relational store.
DATABASE_URL=

# Cloudinary Configuration (Optional - Image Uploads)
# When left blank, ReLoop securely stores uploads locally in public/uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Supabase Configuration (Optional Dual-sync)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application URLs & Settings
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=ReLoop
VITE_DEFAULT_LOCATION=Davanagere, Karnataka
